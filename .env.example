# Set these as process environment variables; this file is not loaded automatically.
OPENAI_API_KEY=
# Set gpt-6-astra only if that model ID is available to your OpenAI API project.
OPENAI_MODEL=
ANALYSIS_MODE=deterministic
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Frontend: Vite loads these from .env.local. Never put secrets in VITE_*.
VITE_USE_MOCK=false
# Empty uses the local Vite /api proxy to http://127.0.0.1:8000.
VITE_API_BASE_URL=
